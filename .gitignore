# Ignorar el contenido de ianseo, pero forzar el rastreo de la carpeta vacía
/ianseo/*
!/ianseo/.gitkeep

# Ignorar archivos de configuración con credenciales reales
/wrapper/config.php

# Ignorar assets de personalización local (logos, etc.)
wrapper/assets/*
!wrapper/assets/.gitkeep

# Ignorar logs de servidor o PHP
*.log
/logs/

# Archivos temporales del sistema operativo
.DS_Store
Thumbs.db
